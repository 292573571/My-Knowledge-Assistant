local.file_match "shihai_runtime" {
  path_targets = [{
    __path__    = "/opt/shihai/logs/my-knowledge-assistant.json.log",
    service     = "shihai",
    environment = sys.env("APP_ENVIRONMENT"),
    instance    = sys.env("INSTANCE_ID"),
  }]
}

loki.source.file "shihai_runtime" {
  targets    = local.file_match.shihai_runtime.targets
  forward_to = [loki.process.shihai_runtime.receiver]
}

loki.process "shihai_runtime" {
  stage.json {
    expressions = {
      level       = "level",
      logger      = "logger",
      timestamp   = "timeMillis",
      request_id  = "contextMap.requestId",
      trace_id    = "contextMap.traceId",
      span_id     = "contextMap.spanId",
      user_id     = "contextMap.userId",
      workspace_id = "contextMap.workspaceId",
      instance_id = "contextMap.instanceId",
      environment = "contextMap.environment",
      message     = "message",
    }
  }

  stage.labels {
    values = {
      level       = "",
      environment = "",
      instance_id = "",
    }
  }

  stage.structured_metadata {
    values = {
      request_id   = "",
      trace_id     = "",
      span_id      = "",
      user_id      = "",
      workspace_id = "",
      logger       = "",
      message      = "",
    }
  }

  forward_to = [loki.write.shihai.receiver]
}

loki.write "shihai" {
  endpoint {
    url = sys.env("LOKI_URL")
  }
}

otelcol.receiver.otlp "shihai" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces  = [otelcol.processor.batch.shihai.input]
    metrics = [otelcol.processor.batch.shihai.input]
  }
}

otelcol.processor.batch "shihai" {
  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.shihai.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = sys.env("TEMPO_OTLP_ENDPOINT")
    tls {
      insecure = true
    }
  }
}

otelcol.exporter.prometheus "shihai" {
  forward_to = [prometheus.remote_write.shihai.receiver]
}

prometheus.remote_write "shihai" {
  endpoint {
    url = sys.env("PROMETHEUS_REMOTE_WRITE_URL")
  }
}
