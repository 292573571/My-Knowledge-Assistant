#!/usr/bin/env bash
set -Eeuo pipefail

# 唯一发版入口：本地直接执行发版，服务器由同一个文件执行 remote 子命令。

remote_deploy() {
  local archive=${1:-}
  local revision=${2:-}
  local app_root=/opt/shihai
  local app_jar="$app_root/app/shihai.jar"
  local frontend_root="$app_root/frontend/dist"
  local releases_root="$app_root/releases"
  local backups_root="$app_root/backups/releases"
  local lock_file=/run/lock/shihai-deploy.lock
  local health_url=${HEALTH_URL:-http://127.0.0.1:8080/api/health}
  local startup_attempts=${STARTUP_ATTEMPTS:-90}
  local startup_interval_seconds=${STARTUP_INTERVAL_SECONDS:-2}
  local release_dir backup_dir
  local service_was_active=false
  local activated=false

  # EXIT trap 执行时函数局部变量已出作用域，回滚与清理所需状态必须存到全局变量。
  SHIHAI_DEPLOY_ARCHIVE=$archive
  SHIHAI_DEPLOY_BACKUP_DIR=''
  SHIHAI_DEPLOY_ACTIVATED=false
  SHIHAI_DEPLOY_SERVICE_WAS_ACTIVE=false
  SHIHAI_DEPLOY_APP_JAR=$app_jar
  SHIHAI_DEPLOY_FRONTEND_ROOT=$frontend_root

  fix_nginx_root() {
    local expected_root="$frontend_root"
    local nginx_conf=/etc/nginx/conf.d/zhihai.conf
    if [[ ! -f "$nginx_conf" ]]; then
      echo "未发现 nginx 配置: ${nginx_conf}，跳过 root 修正" >&2
      return 0
    fi
    if grep -Eq "^[[:space:]]*root[[:space:]]+${expected_root}/?[[:space:]]*;" "$nginx_conf"; then
      return 0
    fi
    if grep -qE '^[[:space:]]*root[[:space:]]+' "$nginx_conf"; then
      sed -i -E "s|^[[:space:]]*root[[:space:]]+[^;]+;|root ${expected_root};|" "$nginx_conf"
      echo "已修正 nginx root 指向 $expected_root"
    else
      echo "nginx 配置缺少 root 指令，请人工处理: $nginx_conf" >&2
      return 1
    fi
    if nginx -t >/dev/null 2>&1; then
      nginx -s reload >/dev/null 2>&1 || systemctl reload nginx >/dev/null 2>&1 || true
      echo "nginx 已重新加载"
    else
      echo "nginx 配置检查失败，请人工处理" >&2
      return 1
    fi
  }

  if [[ -z "$archive" || -z "$revision" || ! "$revision" =~ ^[0-9a-f]{40}$ ]]; then
    echo "用法: deploy-shihai remote <release.tar.gz> <40位Git提交ID>" >&2
    exit 2
  fi
  if [[ ! -f "$archive" ]]; then
    echo "发布包不存在: $archive" >&2
    exit 2
  fi

  exec 9>"$lock_file"
  flock -n 9 || { echo "已有发布任务正在执行" >&2; exit 1; }

  release_dir="$releases_root/$revision"
  backup_dir="$backups_root/$(date -u +%Y%m%dT%H%M%SZ)-${revision:0:12}"
  SHIHAI_DEPLOY_BACKUP_DIR=$backup_dir

  cleanup_archive() {
    rm -f "${SHIHAI_DEPLOY_ARCHIVE:-}"
  }

  # 发版成功后按时间保留最近 N 个 release（默认 5，SHIHAI_KEEP_RELEASES 可调）。
  # 与 cleanup <rev> 的语义不同：那个是「只留 rev 其它全删」，这里是「保留最近 N 个，且永不删当前版本」。
  prune_old_releases() {
    local keep_count=${SHIHAI_KEEP_RELEASES:-5}
    [[ "$keep_count" =~ ^[0-9]+$ ]] || keep_count=5
    local index=0
    local dir
    while IFS= read -r dir; do
      [[ -n "$dir" ]] || continue
      index=$((index + 1))
      [[ "$index" -le "$keep_count" ]] && continue
      [[ "$(basename "$dir")" == "$revision" ]] && continue
      rm -rf -- "$dir"
    done < <(find "$releases_root" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null \
      | sort -nr | cut -d' ' -f2-)
    echo "release 保留策略：最近 ${keep_count} 个，已清理更早版本"
  }

  print_diagnostics() {
    echo "--- systemd status ---" >&2
    systemctl status shihai --no-pager >&2 || true
    echo "--- systemd properties ---" >&2
    systemctl show shihai -p ActiveState -p SubState -p ExecMainStartTimestamp -p ExecMainExitTimestamp -p ExecMainStatus -p Result >&2 || true
    echo "--- recent application log ---" >&2
    journalctl -u shihai.service -n 200 --no-pager >&2 || true
    echo "--- health response ---" >&2
    curl -i --max-time 5 "${health_url:-http://127.0.0.1:8080/api/health}" >&2 || true
  }

  rollback() {
    local status=$?
    if [[ $status -eq 0 || "${SHIHAI_DEPLOY_ACTIVATED:-false}" != true ]]; then
      cleanup_archive
      exit "$status"
    fi

    echo "发布失败，恢复上一版本" >&2
    print_diagnostics
    systemctl stop shihai || true
    if [[ -f "${SHIHAI_DEPLOY_BACKUP_DIR:-}/shihai.jar" ]]; then
      install -m 640 "${SHIHAI_DEPLOY_BACKUP_DIR}/shihai.jar" "${SHIHAI_DEPLOY_APP_JAR:-/opt/shihai/app/shihai.jar}"
    fi
    if [[ -d "${SHIHAI_DEPLOY_BACKUP_DIR:-}/frontend" ]]; then
      rm -rf "${SHIHAI_DEPLOY_FRONTEND_ROOT:-}"
      mkdir -p "${SHIHAI_DEPLOY_FRONTEND_ROOT:-}"
      cp -a "${SHIHAI_DEPLOY_BACKUP_DIR}/frontend/." "${SHIHAI_DEPLOY_FRONTEND_ROOT:-}/"
      chmod -R a+rX "${SHIHAI_DEPLOY_FRONTEND_ROOT:-}"
      chcon -R system_u:object_r:httpd_sys_content_t:s0 "${SHIHAI_DEPLOY_FRONTEND_ROOT:-}" 2>/dev/null || true
    fi
    if [[ "${SHIHAI_DEPLOY_SERVICE_WAS_ACTIVE:-false}" == true ]]; then
      systemctl start shihai || true
    fi
    cleanup_archive
    exit "$status"
  }

  trap rollback EXIT

  mkdir -p "$releases_root" "$backups_root" "$release_dir" "$backup_dir"
  tar -xzf "$archive" -C "$release_dir" --no-same-owner --no-same-permissions
  test -s "$release_dir/backend/shihai.jar"
  test -s "$release_dir/frontend/index.html"
  [[ "$(tr -d '\r\n' < "$release_dir/REVISION")" == "$revision" ]]

  if systemctl is-active --quiet shihai; then
    service_was_active=true
    SHIHAI_DEPLOY_SERVICE_WAS_ACTIVE=true
  fi
  if [[ -f "$app_jar" ]]; then
    cp -a "$app_jar" "$backup_dir/shihai.jar"
  fi
  if [[ -d "$frontend_root" ]]; then
    mkdir -p "$backup_dir/frontend"
    cp -a "$frontend_root/." "$backup_dir/frontend/"
  fi

  activated=true
  SHIHAI_DEPLOY_ACTIVATED=true
  systemctl stop shihai
  install -m 640 "$release_dir/backend/shihai.jar" "$app_jar"
  rm -rf "$frontend_root"
  mkdir -p "$frontend_root"
  cp -a "$release_dir/frontend/." "$frontend_root/"
  chmod -R a+rX "$frontend_root"
  chcon -R system_u:object_r:httpd_sys_content_t:s0 "$frontend_root" 2>/dev/null || true
  fix_nginx_root
  systemctl start shihai

  # 回滚自检用：激活后立即失败，验证 EXIT trap 能把上一版拉回来（仅 deploy-shihai self-test-rollback 会设置）
  if [[ "${SHIHAI_DEPLOY_FORCE_FAIL:-0}" == "1" ]]; then
    echo "自检注入：激活后立即失败，触发回滚" >&2
    exit 1
  fi

  # 发版门禁：健康检查通过后再跑基线评测，未达标则回滚，避免退化版本留在线上。
  run_eval_gate() {
    local env_file=/etc/shihai/shihai.env
    local switch=0 token='' suite=''
    if [[ -r "$env_file" ]]; then
      switch=$(grep -E '^EVAL_DEPLOY_GATE=' "$env_file" | tail -1 | cut -d= -f2- | tr -d "\"'[:space:]" || true)
      token=$(grep -E '^EVAL_GATE_TOKEN=' "$env_file" | tail -1 | cut -d= -f2- | tr -d "\"'[:space:]" || true)
      suite=$(grep -E '^EVAL_GATE_SUITE=' "$env_file" | tail -1 | cut -d= -f2- | tr -d "\"'[:space:]" || true)
    fi
    if [[ "${EVAL_DEPLOY_GATE:-$switch}" == "0" || -z "${EVAL_DEPLOY_GATE:-$switch}" ]]; then
      echo "跳过评测门禁（未设置 EVAL_DEPLOY_GATE）"
      return 0
    fi
    if [[ -z "$token" ]]; then
      echo "评测门禁已开启但缺少 EVAL_GATE_TOKEN，按未通过处理" >&2
      return 1
    fi
    local gate_url="http://127.0.0.1:8080/api/eval/gate"
    local gate_timeout=${EVAL_GATE_TIMEOUT_SECONDS:-900}
    echo "开始评测门禁 suite=${suite:-默认} 超时=${gate_timeout}s"
    local body
    body=$(curl --silent --show-error --max-time "$gate_timeout" -X POST \
      -H "X-Ops-Token: ${token}" --get --data-urlencode "suite=${suite}" "$gate_url" 2>&1) || {
      echo "评测门禁调用失败: ${body}" >&2
      return 1
    }
    echo "评测门禁结果: ${body}"
    if printf '%s' "$body" | grep -q '"passed":true'; then
      return 0
    fi
    if [[ "${EVAL_DEPLOY_GATE:-$switch}" == "warn" ]]; then
      echo "评测门禁未通过（warn 模式仅告警，不阻断发布）" >&2
      return 0
    fi
    echo "评测门禁未通过，阻断本次发布" >&2
    return 1
  }

  for attempt in $(seq 1 "$startup_attempts"); do
    if curl --fail --silent --show-error --max-time 5 "$health_url" >/dev/null; then
      if ! run_eval_gate; then
        exit 1
      fi
      activated=false
      SHIHAI_DEPLOY_ACTIVATED=false
      cleanup_archive
      prune_old_releases
      echo "服务器本地健康检查成功: ${revision}，等待公网健康检查后清理旧版本"
      exit 0
    fi

    if ! systemctl is-active --quiet shihai; then
      echo "shihai 服务已退出，提前结束健康检查" >&2
      exit 1
    fi
    sleep "$startup_interval_seconds"
  done

  echo "健康检查超时: ${health_url}，等待时间=${startup_attempts}x${startup_interval_seconds}s" >&2
  exit 1
}

cleanup_old_releases() {
  local revision=${1:-}
  local app_root=/opt/shihai
  local releases_root="$app_root/releases"
  local backups_root="$app_root/backups/releases"
  local lock_file=/run/lock/shihai-deploy.lock

  if [[ -z "$revision" || ! "$revision" =~ ^[0-9a-f]{40}$ ]]; then
    echo "用法: deploy-shihai cleanup <40位Git提交ID>" >&2
    exit 2
  fi
  [[ -d "$releases_root/$revision" ]] || {
    echo "当前发布目录不存在，拒绝清理: $revision" >&2
    exit 1
  }

  exec 9>"$lock_file"
  flock -n 9 || { echo "已有发布任务正在执行" >&2; exit 1; }
  find "$releases_root" -mindepth 1 -maxdepth 1 -type d ! -name "$revision" -exec rm -rf -- {} +
  # 保留最近一次部署的备份：全部清空会让"当前版本出问题"时无副本可回滚。
  if [[ -d "$backups_root" ]]; then
    local keep_backup
    keep_backup=$(find "$backups_root" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null \
      | sort -nr | head -1 | cut -d' ' -f2-)
    if [[ -n "$keep_backup" ]]; then
      find "$backups_root" -mindepth 1 -maxdepth 1 -type d ! -path "$keep_backup" -exec rm -rf -- {} +
      echo "保留最近备份: $(basename "$keep_backup")"
    fi
  fi
  echo "旧版本已清理，保留版本: $revision"
}

install_self() {
  local source=${1:-}
  if [[ -z "$source" || ! -f "$source" ]]; then
    echo "用法: deploy-shihai install <source-file>" >&2
    exit 2
  fi
  install -m 750 "$source" /usr/local/sbin/deploy-shihai
  rm -f "$source"
  echo "已更新 /usr/local/sbin/deploy-shihai"
}

# 环境变量配置：从 stdin 读 KEY=VALUE 行，合并写入 /etc/shihai/shihai.env。
# 只在服务器上以 root 执行；密钥值走 stdin，不进 argv / ps / history。
# 同名 key 覆盖旧值，其余行保持原样；文件权限固定 root:600。
setenv_keys() {
  local env_file=/etc/shihai/shihai.env
  local tmp keys=0 line key value

  mkdir -p "$(dirname "$env_file")"
  touch "$env_file"
  chmod 600 "$env_file"

  tmp=$(mktemp)
  cp "$env_file" "$tmp"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" != *=* ]]; then
      echo "跳过无效行（缺少 =）: $line" >&2
      continue
    fi
    key=${line%%=*}
    value=${line#*=}
    if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      echo "跳过非法变量名: $key" >&2
      continue
    fi
    if grep -q "^${key}=" "$tmp"; then
      grep -v "^${key}=" "$tmp" > "$tmp.next" || true
      mv "$tmp.next" "$tmp"
    fi
    printf '%s=%s\n' "$key" "$value" >> "$tmp"
    keys=$((keys + 1))
    echo "已写入: $key"
  done
  mv "$tmp" "$env_file"
  chmod 600 "$env_file"
  chown root:root "$env_file" 2>/dev/null || true
  echo "共更新 $keys 个变量 → $env_file"
}

# 重启服务并等待本地健康检查通过。
restart_service() {
  local attempt
  systemctl restart shihai
  echo "已执行 systemctl restart shihai，等待健康检查..."
  for attempt in $(seq 1 60); do
    if curl -fsS --max-time 5 http://127.0.0.1:8080/api/health >/dev/null 2>&1; then
      echo "健康检查通过（第 ${attempt} 次探测）"
      systemctl show shihai -p ActiveEnterTimestamp
      return 0
    fi
    sleep 2
  done
  echo "健康检查超时（120s），请用 journalctl -u shihai -n 100 排查" >&2
  return 1
}


# 数据备份：PostgreSQL（关键）+ 上传文件与配置 + 可选 Chroma 向量库。
# 只在服务器上以 root 执行；默认保留 14 天。
backup_data() {
  local app_root=/opt/shihai
  local data_root="$app_root/backups/data"
  local env_file=/etc/shihai/shihai.env
  local retention_days=${BACKUP_RETENTION_DAYS:-14}
  local pg_user=${BACKUP_PG_USER:-postgres}
  local pg_db=${BACKUP_PG_DB:-postgres}
  local verify=false
  local argument

  for argument in "$@"; do
    case "$argument" in
      --verify) verify=true ;;
      --help|-h) echo "用法: deploy-shihai backup [--verify]"; return 0 ;;
      *) echo "未知参数: $argument" >&2; exit 2 ;;
    esac
  done

  command -v docker >/dev/null 2>&1 || { echo "缺少 docker 命令，无法备份数据库" >&2; exit 1; }

  exec 9>/run/lock/shihai-backup.lock
  flock -n 9 || { echo "已有备份任务正在执行" >&2; exit 1; }

  find_pg_container() {
    local name
    name=$(docker ps --format '{{.Names}} {{.Image}}' 2>/dev/null \
      | awk 'tolower($2) ~ /pgvector/ {print $1; exit}')
    if [[ -z "$name" ]] && docker ps --format '{{.Names}}' 2>/dev/null | grep -qx my-pgvector; then
      name=my-pgvector
    fi
    printf '%s' "$name"
  }

  find_chroma_container() {
    docker ps --format '{{.Names}} {{.Image}}' 2>/dev/null \
      | awk 'tolower($2) ~ /chroma/ {print $1; exit}'
  }

  local pg_container
  pg_container=$(find_pg_container)
  if [[ -z "$pg_container" ]]; then
    echo "未找到 PostgreSQL 容器（pgvector），备份中止" >&2
    exit 1
  fi

  local stamp work archive
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  # flock 已保证不会并发，残留的临时目录一定是历史异常退出留下的，先清掉
  find /tmp -maxdepth 1 -name 'shihai-backup.*' -exec rm -rf {} + 2>/dev/null || true
  work=$(mktemp -d "${TMPDIR:-/tmp}/shihai-backup.XXXXXX")
  archive="$data_root/shihai-backup-$stamp.tar.gz"
  mkdir -p "$data_root"
  chmod 700 "$data_root"
  cleanup_work() { [[ -n "${SHIHAI_BACKUP_WORK:-}" ]] && rm -rf "${SHIHAI_BACKUP_WORK:-}"; return 0; }
  SHIHAI_BACKUP_WORK=$work
  trap cleanup_work EXIT

  echo "备份开始: $stamp（数据库容器 $pg_container）"

  # 1) PostgreSQL 全库自定义格式转储，并立即校验归档可读
  docker exec "$pg_container" pg_dump -U "$pg_user" -d "$pg_db" -Fc -Z 6 > "$work/postgres.dump"
  if [[ ! -s "$work/postgres.dump" ]]; then
    echo "pg_dump 输出为空，备份失败" >&2
    exit 1
  fi
  if ! docker exec -i "$pg_container" pg_restore -l < "$work/postgres.dump" > /dev/null; then
    echo "转储文件无法被 pg_restore 解析，备份失败" >&2
    exit 1
  fi

  # 2) 上传文件与用户资产（缺失则跳过，不阻断备份）
  local file_targets=()
  local dir
  for dir in docs data; do
    [[ -d "$app_root/$dir" ]] && file_targets+=("$dir")
  done
  if [[ ${#file_targets[@]} -gt 0 ]]; then
    tar -czf "$work/files.tar.gz" -C "$app_root" "${file_targets[@]}"
  fi

  # 3) 环境变量（含数据库口令与模型密钥），单独存且保持 600
  if [[ -f "$env_file" ]]; then
    install -m 600 "$env_file" "$work/shihai.env"
  fi

  # 4) Chroma 向量库（可重建，尽力而为：找到挂载目录才备份）
  local chroma_included=false
  local chroma_container chroma_source=''
  chroma_container=$(find_chroma_container)
  if [[ "${BACKUP_INCLUDE_CHROMA:-1}" != "0" && -n "$chroma_container" ]]; then
    chroma_source=$(docker inspect -f '{{range .Mounts}}{{.Source}}|{{.Destination}} {{end}}' "$chroma_container" 2>/dev/null \
      | tr ' ' '\n' | awk -F'|' 'tolower($2) ~ /chroma|data/ {print $1; exit}')
  fi
  if [[ -n "$chroma_source" && -d "$chroma_source" ]]; then
    if tar -czf "$work/chroma-data.tar.gz" -C "$(dirname "$chroma_source")" "$(basename "$chroma_source")"; then
      chroma_included=true
    else
      rm -f "$work/chroma-data.tar.gz"
    fi
  fi

  # 5) 清单与校验和
  local revision='unknown'
  revision=$(find "$app_root/releases" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | head -1)
  [[ "$revision" =~ ^[0-9a-f]{40}$ ]] || revision=unknown
  local pg_bytes
  pg_bytes=$(stat -c %s "$work/postgres.dump")
  cat > "$work/manifest.txt" <<EOF
created_at=$stamp
revision=$revision
pg_container=$pg_container
pg_database=$pg_db
pg_bytes=$pg_bytes
files=${file_targets[*]:-none}
env_included=$([[ -f "$work/shihai.env" ]] && echo yes || echo no)
chroma_included=$chroma_included
chroma_source=${chroma_source:-none}
EOF
  ( cd "$work" && find . -maxdepth 1 -type f ! -name SHA256SUMS -printf '%f\n' | sort | xargs -r sha256sum > SHA256SUMS )

  chmod -R go-rwx "$work"
  tar -czf "$archive" -C "$work" .
  chmod 600 "$archive"
  sha256sum "$archive" | awk '{print $1}' > "$archive.sha256"

  local archive_size
  archive_size=$(du -h "$archive" | cut -f1)

  # 6) 恢复演练：把转储还原到临时库并比对表数量，证明备份真的可用
  if [[ "$verify" == true ]]; then
    local check_db=shihai_restore_check
    echo "开始恢复演练（临时库 $check_db）..."
    docker exec "$pg_container" psql -U "$pg_user" -d postgres -q -c "drop database if exists $check_db" >/dev/null
    docker exec "$pg_container" psql -U "$pg_user" -d postgres -q -c "create database $check_db" >/dev/null
    if ! docker exec -i "$pg_container" pg_restore -U "$pg_user" -d "$check_db" --no-owner --no-privileges < "$work/postgres.dump" >/dev/null 2>&1; then
      echo "恢复演练失败：pg_restore 报错" >&2
      docker exec "$pg_container" psql -U "$pg_user" -d postgres -q -c "drop database if exists $check_db" >/dev/null || true
      exit 1
    fi
    local live_tables restored_tables live_rows restored_rows
    live_tables=$(docker exec "$pg_container" psql -U "$pg_user" -d "$pg_db" -Atc \
      "select count(*) from pg_tables where schemaname='my_knowledge_assistant'")
    restored_tables=$(docker exec "$pg_container" psql -U "$pg_user" -d "$check_db" -Atc \
      "select count(*) from pg_tables where schemaname='my_knowledge_assistant'")
    live_rows=$(printf '%s\n' "select format('select count(*) from %I.%I', schemaname, tablename) from pg_tables where schemaname='my_knowledge_assistant' \\gexec" \
      | docker exec -i "$pg_container" psql -U "$pg_user" -d "$pg_db" -At | awk '{sum+=$1} END {print sum+0}')
    restored_rows=$(printf '%s\n' "select format('select count(*) from %I.%I', schemaname, tablename) from pg_tables where schemaname='my_knowledge_assistant' \\gexec" \
      | docker exec -i "$pg_container" psql -U "$pg_user" -d "$check_db" -At | awk '{sum+=$1} END {print sum+0}')
    docker exec "$pg_container" psql -U "$pg_user" -d postgres -q -c "drop database if exists $check_db" >/dev/null || true
    if [[ "$live_tables" != "$restored_tables" || "$restored_rows" != "$live_rows" ]]; then
      echo "恢复演练失败：线上表 ${live_tables}/行 ${live_rows}，还原后 ${restored_tables}/行 ${restored_rows}" >&2
      exit 1
    fi
    echo "恢复演练通过：表 ${restored_tables} 张、行 ${restored_rows} 条，与线上一致"
  fi

  # 7) 保留策略：删除超过 N 天的备份，但始终保留最新一份
  local newest
  newest=$(find "$data_root" -maxdepth 1 -name 'shihai-backup-*.tar.gz' -printf '%T@ %p\n' \
    | sort -nr | head -1 | cut -d' ' -f2-)
  find "$data_root" -maxdepth 1 -name 'shihai-backup-*.tar.gz' -mtime +"$retention_days" ! -path "$newest" -delete
  find "$data_root" -maxdepth 1 -name 'shihai-backup-*.tar.gz.sha256' -mtime +"$retention_days" -delete

  echo "备份完成: $archive (${archive_size})"
  echo "  数据库: $(numfmt --to=iec "$pg_bytes" 2>/dev/null || echo "${pg_bytes}B")，容器 $pg_container"
  echo "  文件: ${file_targets[*]:-无}"
  echo "  Chroma: $([[ "$chroma_included" == true ]] && echo "已包含" || echo "已跳过（向量可由文档重建）")"
  echo "  保留: 最近 ${retention_days} 天，共 $(find "$data_root" -maxdepth 1 -name 'shihai-backup-*.tar.gz' | wc -l) 份"
}

# 列出已有备份并展示最新一份的清单。
list_backups() {
  local data_root=/opt/shihai/backups/data
  if [[ ! -d "$data_root" ]]; then
    echo "还没有备份: $data_root 不存在"
    exit 1
  fi
  local archives=()
  mapfile -t archives < <(find "$data_root" -maxdepth 1 -name 'shihai-backup-*.tar.gz' -printf '%T@ %p\n' | sort -nr | cut -d' ' -f2-)
  if [[ ${#archives[@]} -eq 0 ]]; then
    echo "还没有备份文件"
    exit 1
  fi
  echo "备份目录: $data_root（共 ${#archives[@]} 份）"
  local item size created
  for item in "${archives[@]}"; do
    size=$(du -h "$item" | cut -f1)
    created=$(date -r "$item" '+%Y-%m-%d %H:%M')
    printf '  %s  %6s  %s\n' "$created" "$size" "$(basename "$item")"
  done
  echo
  echo "最新备份清单:"
  tar -xzOf "${archives[0]}" ./manifest.txt | sed 's/^/  /'
}

# 回滚自检：用当前线上产物造一个发布包，注入「激活后失败」，确认脚本能把上一版恢复回来。
self_test_rollback() {
  local app_root=/opt/shihai
  local app_jar=$app_root/app/shihai.jar
  local frontend_root=$app_root/frontend/dist
  local health_url=${HEALTH_URL:-http://127.0.0.1:8080/api/health}
  [[ -f "$app_jar" ]] || { echo "找不到 $app_jar，无法自检" >&2; exit 1; }

  local work rev
  find /tmp -maxdepth 1 -name 'shihai-selftest.*' -exec rm -rf {} + 2>/dev/null || true
  work=$(mktemp -d "${TMPDIR:-/tmp}/shihai-selftest.XXXXXX")
  rev=$(printf 'f%.0s' {1..40})
  mkdir -p "$work/pkg/backend" "$work/pkg/frontend"
  cp -a "$app_jar" "$work/pkg/backend/shihai.jar"
  cp -a "$frontend_root/." "$work/pkg/frontend/"
  printf '%s\n' "$rev" > "$work/pkg/REVISION"
  tar -czf "$work/release.tar.gz" -C "$work/pkg" .
  chmod -R go-rwx "$work"

  local jar_before jar_after status
  jar_before=$(sha256sum "$app_jar" | cut -d' ' -f1)
  echo "自检开始：当前 jar ${jar_before:0:12}，将发布一个注入失败的版本"

  set +e
  ( export SHIHAI_DEPLOY_FORCE_FAIL=1; remote_deploy "$work/release.tar.gz" "$rev" )
  status=$?
  set -e

  jar_after=$(sha256sum "$app_jar" | cut -d' ' -f1)
  local attempt health=000
  for attempt in $(seq 1 30); do
    health=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$health_url" 2>/dev/null || echo 000)
    [[ "$health" == "200" ]] && break
    sleep 1
  done

  rm -rf "$app_root/releases/$rev" "$work"

  echo "自检结果：注入失败退出码=$status（期望 1）"
  echo "          jar 哈希 ${jar_after:0:12}（期望与开始一致）"
  echo "          服务健康=$health（期望 200）"
  if [[ "$status" == "1" && "$jar_before" == "$jar_after" && "$health" == "200" ]]; then
    echo "回滚自检通过：失败版本已自动回滚到上一版"
    return 0
  fi
  echo "回滚自检未通过，尝试恢复服务" >&2
  systemctl start shihai || true
  exit 1
}

# 安装每日备份定时器（systemd timer），默认 03:30 执行。
install_backup_timer() {
  local schedule=${1:-03:30}
  if [[ ! "$schedule" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
    echo "用法: deploy-shihai install-backup-timer [HH:MM]" >&2
    exit 2
  fi
  local hour=${schedule%%:*}
  local minute=${schedule##*:}

  cat > /etc/systemd/system/shihai-backup.service <<EOF
[Unit]
Description=shihai 数据备份（PostgreSQL + 上传文件）
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/deploy-shihai backup
Nice=10
IOSchedulingClass=best-effort
EOF

  cat > /etc/systemd/system/shihai-backup.timer <<EOF
[Unit]
Description=每天 ${schedule} 备份 shihai 数据

[Timer]
OnCalendar=*-*-* ${hour}:${minute}:00
Persistent=true
RandomizedDelaySec=300
Unit=shihai-backup.service

[Install]
WantedBy=timers.target
EOF

  systemctl daemon-reload
  systemctl enable --now shihai-backup.timer >/dev/null
  echo "已安装定时备份：每天 ${schedule}（易错过时间点会自动补跑）"
  systemctl list-timers shihai-backup.timer --no-pager | head -3
}

release_local() {
  local project_root
  project_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
  local deploy_host=${DEPLOY_HOST:-175.178.229.209}
  local deploy_port=${DEPLOY_PORT:-22}
  local deploy_user=${DEPLOY_USER:-deploy}
  local deploy_key=${DEPLOY_KEY:-$HOME/.ssh/shihai_deploy_key}
  local public_health_url=${PUBLIC_HEALTH_URL:-http://$deploy_host/api/health}
  local remote_deploy_script=/usr/local/sbin/deploy-shihai
  local assume_yes=false

  usage() {
    cat <<'EOF'
用法: ./deploy/deploy-shihai [--yes]

服务器内部模式：
  deploy-shihai remote <release.tar.gz> <40位Git提交ID>
  deploy-shihai cleanup <40位Git提交ID>
  deploy-shihai install <source-file>
  deploy-shihai backup [--verify]              立即备份（--verify 额外做恢复演练）
  deploy-shihai backup-list                    查看已有备份
  deploy-shihai install-backup-timer [HH:MM]   安装每日备份定时器，默认 03:30
  deploy-shihai self-test-rollback             验证失败发布能自动回滚（会重启一次服务）

环境变量：
  DEPLOY_HOST        服务器地址，默认 175.178.229.209
  DEPLOY_PORT        SSH 端口，默认 22
  DEPLOY_USER        SSH 用户，默认 deploy
  DEPLOY_KEY         SSH 私钥，默认 ~/.ssh/shihai_deploy_key
  MAVEN_BIN          Maven 命令路径
  PUBLIC_HEALTH_URL  公网健康检查地址
EOF
  }

  for argument in "$@"; do
    case "$argument" in
      --yes) assume_yes=true ;;
      --help|-h) usage; exit 0 ;;
      *) echo "未知参数: $argument" >&2; usage >&2; exit 2 ;;
    esac
  done

  require_command() {
    command -v "$1" >/dev/null 2>&1 || { echo "缺少命令: $1" >&2; exit 1; }
  }
  require_command git
  require_command rsync
  require_command ssh
  require_command curl
  require_command tar

  local maven_bin
  if [[ -n "${MAVEN_BIN:-}" ]]; then
    maven_bin=$MAVEN_BIN
  elif command -v mvn >/dev/null 2>&1; then
    maven_bin=$(command -v mvn)
  elif [[ -x "$HOME/apache-maven-3.6.3/bin/mvn" ]]; then
    maven_bin="$HOME/apache-maven-3.6.3/bin/mvn"
  else
    echo "未找到 Maven，请通过 MAVEN_BIN 指定 mvn 路径" >&2
    exit 1
  fi

  [[ -x "$maven_bin" ]] || { echo "Maven 不可执行: $maven_bin" >&2; exit 1; }
  [[ -f "$deploy_key" ]] || { echo "部署私钥不存在: $deploy_key" >&2; exit 1; }

  local ssh_options=(
    -i "$deploy_key" -p "$deploy_port" -o IdentitiesOnly=yes -o BatchMode=yes
    -o ConnectTimeout=15 -o ServerAliveInterval=30 -o ServerAliveCountMax=6
  )
  local remote="$deploy_user@$deploy_host"

  cd "$project_root"
  local branch revision remote_revision
  branch=$(git branch --show-current)
  [[ "$branch" == "master" ]] || { echo "只能从 master 发版，当前分支: $branch" >&2; exit 1; }
  if ! git diff --quiet || ! git diff --cached --quiet || [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
    echo "工作区存在未提交内容，请先提交或清理后再发版" >&2
    git status --short
    exit 1
  fi

  echo "正在确认本地 master 已推送到 origin/master..."
  git fetch --quiet origin master
  revision=$(git rev-parse HEAD)
  remote_revision=$(git rev-parse origin/master)
  [[ "$revision" == "$remote_revision" ]] || {
    echo "本地 master 与 origin/master 不一致，请先完成 pull/push" >&2
    exit 1
  }

  if [[ "$assume_yes" != true ]]; then
    printf '确认发布 master %s 到 %s？[y/N] ' "${revision:0:12}" "$deploy_host"
    read -r confirmation
    [[ "$confirmation" == "y" || "$confirmation" == "Y" ]] || { echo "已取消"; exit 0; }
  fi

  echo "正在检查服务器发布环境..."
  local remote_rsync
  remote_rsync=$(ssh "${ssh_options[@]}" "$remote" "command -v rsync" 2>&1) || {
    echo "服务器预检失败：服务器没有找到 rsync。请在服务器执行：" >&2
    echo "  dnf install -y rsync" >&2
    echo "$remote_rsync" >&2
    exit 1
  }

  local remote_help
  remote_help=$(ssh "${ssh_options[@]}" "$remote" \
    "sudo -n '$remote_deploy_script' --help" 2>&1) || {
    echo "服务器预检失败：deploy 用户不能免密执行 $remote_deploy_script --help。" >&2
    echo "请确认 sudoers 中包含：" >&2
    echo "  deploy ALL=(root) NOPASSWD: $remote_deploy_script *" >&2
    echo "$remote_help" >&2
    exit 1
  }
  if [[ "$remote_help" != *"deploy-shihai cleanup"* ]]; then
    echo "服务器上的 $remote_deploy_script 仍是旧版，请先更新一次统一发版脚本。" >&2
    echo "旧版输出: $remote_help" >&2
    echo "请先运行：" >&2
    echo "  scp -i \"$deploy_key\" -P \"$deploy_port\" deploy/deploy-shihai \"$remote:/tmp/deploy-shihai\"" >&2
    echo "  ssh -tt -i \"$deploy_key\" -p \"$deploy_port\" \"$remote\" \"sudo install -m 750 /tmp/deploy-shihai $remote_deploy_script && rm -f /tmp/deploy-shihai\"" >&2
    exit 1
  fi

  local work_dir archive remote_archive
  work_dir=$(mktemp -d "${TMPDIR:-/tmp}/shihai-release.XXXXXX")
  archive="$work_dir/shihai-$revision.tar.gz"
  remote_archive="/tmp/shihai-$revision.tar.gz"
  cleanup_local() { rm -rf "$work_dir"; }
  trap cleanup_local EXIT

  echo "[1/5] 测试并打包后端"
  "$maven_bin" --batch-mode --no-transfer-progress clean package
  local backend_jars=(target/*.jar)
  if [[ ${#backend_jars[@]} -ne 1 || ! -f "${backend_jars[0]}" ]]; then
    echo "预期 target 中存在一个可执行 JAR" >&2
    exit 1
  fi

  echo "[2/5] 安装依赖并构建前端"
  (
    cd frontend
    if [[ -f package-lock.json ]]; then
      require_command npm
      npm ci
    elif [[ -f yarn.lock ]]; then
      require_command yarn
      yarn install --frozen-lockfile
    else
      echo "frontend 中缺少 package-lock.json 或 yarn.lock" >&2
      exit 1
    fi
    npm run build
  )

  echo "[3/5] 生成发布包"
  mkdir -p "$work_dir/release/backend" "$work_dir/release/frontend"
  cp "${backend_jars[0]}" "$work_dir/release/backend/shihai.jar"
  cp -R frontend/dist/. "$work_dir/release/frontend/"
  printf '%s\n' "$revision" > "$work_dir/release/REVISION"
  COPYFILE_DISABLE=1 tar -czf "$archive" -C "$work_dir/release" .
  ls -lh "$archive"

  echo "[4/5] 上传发布包"
  rsync --archive --compress --partial --progress \
    -e "ssh -i $deploy_key -p $deploy_port -o IdentitiesOnly=yes -o BatchMode=yes -o ServerAliveInterval=30" \
    "$archive" "$remote:$remote_archive"
  echo "[4.5/5] 同步部署脚本"
  rsync --archive --compress \
    -e "ssh -i $deploy_key -p $deploy_port -o IdentitiesOnly=yes -o BatchMode=yes -o ServerAliveInterval=30" \
    "$0" "$remote:/tmp/deploy-shihai.new"
  ssh "${ssh_options[@]}" "$remote" \
    "sudo -n '$remote_deploy_script' install /tmp/deploy-shihai.new" || {
    echo "服务器预检失败：deploy 用户不能免密执行 $remote_deploy_script install。" >&2
    echo "请确认 sudoers 中包含 deploy ALL=(root) NOPASSWD: $remote_deploy_script *" >&2
    exit 1
  }
  echo "[5/5] 部署并执行健康检查"
  revision=${revision:-$(git rev-parse HEAD 2>/dev/null)}
  ssh "${ssh_options[@]}" "$remote" \
    "sudo -n '$remote_deploy_script' remote '$remote_archive' '$revision'"

  local public_health_attempts=${PUBLIC_HEALTH_ATTEMPTS:-30}
  local public_health_interval=${PUBLIC_HEALTH_INTERVAL_SECONDS:-2}
  for attempt in $(seq 1 "$public_health_attempts"); do
    if curl --fail --silent --show-error --max-time 15 "$public_health_url" >/dev/null; then
      ssh "${ssh_options[@]}" "$remote" \
        "sudo -n '$remote_deploy_script' cleanup '$revision'"
      echo "公网健康检查成功: $public_health_url"
      echo "发版成功: ${revision}，旧版本已清理"
      exit 0
    fi
    sleep "$public_health_interval"
  done

  echo "远端部署命令已完成，但公网健康检查超时: $public_health_url" >&2
  echo "请检查反向代理、防火墙和公网 DNS；远端本地健康检查已由 $remote_deploy_script 执行" >&2
  exit 1
}

if [[ "${1:-}" == "remote" ]]; then
  shift
  remote_deploy "$@"
elif [[ "${1:-}" == "cleanup" ]]; then
  shift
  cleanup_old_releases "$@"
elif [[ "${1:-}" == "install" ]]; then
  shift
  install_self "$@"
elif [[ "${1:-}" == "backup" ]]; then
  shift
  backup_data "$@"
elif [[ "${1:-}" == "install-backup-timer" ]]; then
  shift
  install_backup_timer "$@"
elif [[ "${1:-}" == "backup-list" ]]; then
  shift
  list_backups "$@"
elif [[ "${1:-}" == "self-test-rollback" ]]; then
  shift
  self_test_rollback "$@"
elif [[ "${1:-}" == "setenv" ]]; then
  shift
  setenv_keys "$@"
elif [[ "${1:-}" == "restart" ]]; then
  shift
  restart_service "$@"
else
  release_local "$@"
fi
