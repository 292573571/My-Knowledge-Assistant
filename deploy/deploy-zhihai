#!/usr/bin/env bash
set -Eeuo pipefail

APP_ROOT=/opt/zhihai
APP_JAR="$APP_ROOT/app/zhihai.jar"
FRONTEND_ROOT="$APP_ROOT/frontend/dist"
RELEASES_ROOT="$APP_ROOT/releases"
BACKUPS_ROOT="$APP_ROOT/backups/releases"
LOCK_FILE=/run/lock/zhihai-deploy.lock
HEALTH_URL=${HEALTH_URL:-http://127.0.0.1:8080/api/health}
STARTUP_ATTEMPTS=${STARTUP_ATTEMPTS:-90}
STARTUP_INTERVAL_SECONDS=${STARTUP_INTERVAL_SECONDS:-2}

archive=${1:-}
revision=${2:-}

if [[ -z "$archive" || -z "$revision" || ! "$revision" =~ ^[0-9a-f]{40}$ ]]; then
  echo "用法: deploy-zhihai <release.tar.gz> <40位Git提交ID>" >&2
  exit 2
fi

if [[ ! -f "$archive" ]]; then
  echo "发布包不存在: $archive" >&2
  exit 2
fi

exec 9>"$LOCK_FILE"
flock -n 9 || { echo "已有发布任务正在执行" >&2; exit 1; }

release_dir="$RELEASES_ROOT/$revision"
backup_dir="$BACKUPS_ROOT/$(date -u +%Y%m%dT%H%M%SZ)-${revision:0:12}"
service_was_active=false
activated=false

cleanup() {
  rm -f "$archive"
}

print_diagnostics() {
  echo "--- systemd status ---" >&2
  systemctl status zhihai --no-pager >&2 || true
  echo "--- systemd properties ---" >&2
  systemctl show zhihai -p ActiveState -p SubState -p ExecMainStartTimestamp -p ExecMainExitTimestamp -p ExecMainStatus -p Result >&2 || true
  echo "--- recent application log ---" >&2
  journalctl -u zhihai.service -n 200 --no-pager >&2 || true
  echo "--- health response ---" >&2
  curl -i --max-time 5 "$HEALTH_URL" >&2 || true
}

rollback() {
  status=$?
  if [[ $status -eq 0 || "$activated" != true ]]; then
    cleanup
    exit "$status"
  fi

  echo "发布失败，恢复上一版本" >&2
  print_diagnostics
  systemctl stop zhihai || true
  if [[ -f "$backup_dir/zhihai.jar" ]]; then
    install -m 640 "$backup_dir/zhihai.jar" "$APP_JAR"
  fi
  if [[ -d "$backup_dir/frontend" ]]; then
    rm -rf "$FRONTEND_ROOT"
    mkdir -p "$FRONTEND_ROOT"
    cp -a "$backup_dir/frontend/." "$FRONTEND_ROOT/"
    chmod -R a+rX "$FRONTEND_ROOT"
    chcon -R system_u:object_r:httpd_sys_content_t:s0 "$FRONTEND_ROOT" 2>/dev/null || true
  fi
  if [[ "$service_was_active" == true ]]; then
    systemctl start zhihai || true
  fi
  cleanup
  exit "$status"
}

trap rollback EXIT

mkdir -p "$RELEASES_ROOT" "$BACKUPS_ROOT" "$release_dir" "$backup_dir"
tar -xzf "$archive" -C "$release_dir" --no-same-owner --no-same-permissions

test -s "$release_dir/backend/zhihai.jar"
test -s "$release_dir/frontend/index.html"
[[ "$(tr -d '\r\n' < "$release_dir/REVISION")" == "$revision" ]]

if systemctl is-active --quiet zhihai; then
  service_was_active=true
fi
if [[ -f "$APP_JAR" ]]; then
  cp -a "$APP_JAR" "$backup_dir/zhihai.jar"
fi
if [[ -d "$FRONTEND_ROOT" ]]; then
  mkdir -p "$backup_dir/frontend"
  cp -a "$FRONTEND_ROOT/." "$backup_dir/frontend/"
fi

activated=true
systemctl stop zhihai
install -m 640 "$release_dir/backend/zhihai.jar" "$APP_JAR"
rm -rf "$FRONTEND_ROOT"
mkdir -p "$FRONTEND_ROOT"
cp -a "$release_dir/frontend/." "$FRONTEND_ROOT/"
chmod -R a+rX "$FRONTEND_ROOT"
chcon -R system_u:object_r:httpd_sys_content_t:s0 "$FRONTEND_ROOT" 2>/dev/null || true
systemctl start zhihai

for attempt in $(seq 1 "$STARTUP_ATTEMPTS"); do
  if curl --fail --silent --show-error --max-time 5 "$HEALTH_URL" >/dev/null; then
    activated=false
    cleanup
    find "$RELEASES_ROOT" -mindepth 1 -maxdepth 1 -type d -mtime +14 -exec rm -rf -- {} +
    find "$BACKUPS_ROOT" -mindepth 1 -maxdepth 1 -type d -mtime +14 -exec rm -rf -- {} +
    echo "发布成功: $revision"
    exit 0
  fi

  if ! systemctl is-active --quiet zhihai; then
    echo "zhihai 服务已退出，提前结束健康检查" >&2
    exit 1
  fi
  sleep "$STARTUP_INTERVAL_SECONDS"
done

echo "健康检查超时: $HEALTH_URL，等待时间=${STARTUP_ATTEMPTS}x${STARTUP_INTERVAL_SECONDS}s" >&2
exit 1
