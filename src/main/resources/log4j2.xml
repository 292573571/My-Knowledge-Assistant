<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>
        </Console>
        <RollingFile name="File" fileName="${env:LOG_PATH:-logs}/workbench.log"
                     filePattern="${env:LOG_PATH:-logs}/workbench.%d{yyyy-MM-dd}.%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="50MB"/>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="14">
                <Delete basePath="${env:LOG_PATH:-logs}" maxDepth="1">
                    <IfFileName glob="workbench.*.log.gz"/>
                    <IfAccumulatedFileSize exceeds="1GB"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
        <Jpa name="Jpa"/>
    </Appenders>
    <Loggers>
        <Logger name="com.example.workbench" level="INFO"/>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
            <AppenderRef ref="Jpa"/>
        </Root>
    </Loggers>
</Configuration>
